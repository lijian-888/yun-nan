{
  "realm": "rice-research",
  "enabled": true,
  "displayName": "云南省农业科学院 · 隆耘 Agent 育种智能体",
  "registrationAllowed": false,
  "loginWithEmailAllowed": false,
  "eventsEnabled": true,
  "adminEventsEnabled": true,
  "adminEventsDetailsEnabled": true,
  "roles": {
    "realm": [
      {
        "name": "researcher",
        "description": "Can access published standard data and their own private research sessions."
      },
      {
        "name": "data_processor",
        "description": "Can import, review, correct, and publish high-standard dataset records."
      },
      {
        "name": "field_admin",
        "description": "Can maintain high-standard dataset templates, field definitions, and rule versions."
      }
    ]
  },
  "clients": [
    {
      "clientId": "rice-research-web",
      "name": "YNAAS Longyun Agent Breeding Intelligence Web",
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "http://localhost:5183/*"
      ],
      "webOrigins": [
        "http://localhost:5183"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      }
    }
  ],
  "users": [
    {
      "username": "ynaas.researcher",
      "enabled": true,
      "firstName": "科研人员",
      "lastName": "云南农科院",
      "email": "ynaas.researcher@example.local",
      "emailVerified": true,
      "realmRoles": [
        "researcher"
      ],
      "credentials": [
        {
          "type": "password",
          "value": "CHANGE_ME_RESEARCHER_BEFORE_USE",
          "temporary": true
        }
      ],
      "requiredActions": ["UPDATE_PASSWORD"]
    },
    {
      "username": "ynaas.processor",
      "enabled": true,
      "firstName": "数据处理员",
      "lastName": "云南农科院",
      "email": "ynaas.processor@example.local",
      "emailVerified": true,
      "realmRoles": [
        "data_processor"
      ],
      "credentials": [
        {
          "type": "password",
          "value": "CHANGE_ME_PROCESSOR_BEFORE_USE",
          "temporary": true
        }
      ],
      "requiredActions": ["UPDATE_PASSWORD"]
    },
    {
      "username": "ynaas.fieldadmin",
      "enabled": true,
      "firstName": "字段管理员",
      "lastName": "云南农科院",
      "email": "ynaas.fieldadmin@example.local",
      "emailVerified": true,
      "realmRoles": [
        "field_admin"
      ],
      "credentials": [
        {
          "type": "password",
          "value": "CHANGE_ME_FIELD_ADMIN_BEFORE_USE",
          "temporary": true
        }
      ],
      "requiredActions": ["UPDATE_PASSWORD"]
    }
  ]
}
