# 复制为 deploy/ynaas-193/.env；实际口令只放在服务器上，权限设为 600。
COMPOSE_PROJECT_NAME=ynaas-trial
RELEASE_TAG=trial-001
PUBLIC_PLATFORM_URL=https://172.16.123.193:19443
PUBLIC_PLATFORM_HOST=172.16.123.193
HTTPS_PORT=19443
TLS_CERT_FILE=./deploy/ynaas-193/certs/server.crt
TLS_KEY_FILE=./deploy/ynaas-193/certs/server.key

INSTITUTION_ID=yunnan-academy-agricultural-sciences
INSTITUTION_CODE=YNAAS
INSTITUTION_NAME=云南省农业科学院
DEFAULT_PROJECT_CODE=YNAAS-DEFAULT
DEFAULT_PROJECT_NAME=云南省农业科学院水稻育种研究
DEMO_DATA_ENABLED=false
INSTITUTION_DATA_ENABLED=false
ENABLE_SOURCE_DEDUPLICATION=true

POSTGRES_PASSWORD=CHANGE_ME_BEFORE_USE
APP_DATABASE_PASSWORD=CHANGE_ME_BEFORE_USE
KEYCLOAK_DATABASE_PASSWORD=CHANGE_ME_BEFORE_USE
MINIO_ROOT_USER=ynaas-minio
MINIO_ROOT_PASSWORD=CHANGE_ME_BEFORE_USE
KEYCLOAK_ADMIN_USERNAME=ynaas-admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME_BEFORE_USE
# Server-side service account for researcher provisioning. Configure after
# creating a least-privilege client in the rice-research realm.
KEYCLOAK_PROVISION_CLIENT_ID=
KEYCLOAK_PROVISION_CLIENT_SECRET=
INITIAL_RESEARCHER_PASSWORD=CHANGE_ME_BEFORE_USE
INITIAL_PROCESSOR_PASSWORD=CHANGE_ME_BEFORE_USE
INITIAL_FIELD_ADMIN_PASSWORD=CHANGE_ME_BEFORE_USE

AI_PROVIDER=cherryin
YUNNAN_API_BASE_URL=https://open.cherryin.net/v1
YUNNAN_MODEL=agent/deepseek-v4-flash
YUNNAN_API_KEY=
TAVILY_API_KEY=
KNOWLEDGE_DOCUMENT_CONCURRENCY=1
ACPS_ENABLED=false
ACPS_AGENT_NAME=云南水稻育种智能体
